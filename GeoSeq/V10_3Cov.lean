namespace GeoSeq

-- the kernel unfolds the field instances of the models when checking the instances of the row theorems
set_option maxHeartbeats 0

/-- The conclusion of `prop:primepower` gives `Covered` on the full levels (`lem:prefix`). -/
theorem covered_of_concl {R : Type*} [CommRing R] {q : ℕ} [NeZero q] (D : DigitCode R q) (hq : 2 ≤ q) (s : ℕ)
    (hs : 1 ≤ s) (C : Gen s R) (β : ℝ) (hβ : 0 < β) (h : PPConcl D s C β) : Covered D s C (levFull s) :=
  covered_full D hq hs C h.1 β hβ h.2.1

/-- Distinct codes below `q` give distinct elements (the places `a_c = dec c`). -/
theorem PF.dec_fin_injective {p d : ℕ} {fc : Fin (d + 1) → ZMod p} [NeZero p] {s : ℕ} (hs : s ≤ p ^ (d + 1)) :
    Function.Injective (fun c : Fin s => (PF.dec (c : ℕ) : PF p d fc)) := by
  intro i j h
  have h1 := congrArg PF.encN h
  simp only at h1
  rw [PF.encN_dec _ (lt_of_lt_of_le i.isLt hs), PF.encN_dec _ (lt_of_lt_of_le j.isLt hs)] at h1
  exact Fin.ext h1

