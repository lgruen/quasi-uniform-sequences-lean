def K4tupv (t i : ℕ) : F4 := n2f ((K4tup.getD t []).getD i 0)

/-! ## The certificate check on words -/

/-- Entry `(i, c)` of the change column of type `ty` of tuple `t` (`eq:carrychange`, `Δ(ȳ) = ω²`):
`ω² D_i(l)[c][0]` for `ty = 0` (`Δ(y) = ω²`), `D_i(l)[c][0] + ω D_i(l-1)[c][0]` for `ty = 1`
(`Δ(y) = 1`). -/
def chgF (t ty i : ℕ) (c : Fin 3) : F4 :=
  if ty = 0 then F4.w2 * K4tupv t (3 * i + c) else K4tupv t (3 * i + c) + F4.w * K4tupv t (24 + 3 * i + c)

/-- The lower bound for `4^8 f_8(e_c, σ_c)` from the word `w = enc σ_c`: `4^8 - 1 - w` if coordinate `c`
moves (`m = true`), `topW 8 w - 1` otherwise (`GeoSeq/K4Gap.lean`). -/
def k4b (m : Bool) (w : ℕ) : ℕ := if m then 65535 - w else topW 8 w - 1

/-- One case of the certificate check: `∑_c (bound)² ≥ 54774953`. -/
def k4ok (m0 m1 m2 : Bool) (w0 w1 w2 : ℕ) : Bool :=
  decide (54774953 ≤ k4b m0 w0 ^ 2 + k4b m1 w1 ^ 2 + k4b m2 w2 ^ 2)

/-- The change columns a source can contribute: all of `K4Z` if it moves, the zero column if not. -/
def k4opt (m : Bool) : List (List ℕ) := if m then K4Z else [[0, 0, 0]]

/-- The certificate check for the moving set `(m0, m1, m2)`: source `c'` contributes to target `c`
the word of target offset `c - c'` (mod `3`) of its change column (rotation symmetry). -/
def k4chk (m0 m1 m2 : Bool) : Bool :=
  (k4opt m0).all fun a => (k4opt m1).all fun b =>
    (k4opt m2).all fun d =>
      k4ok m0 m1 m2 (a.getD 0 0 ^^^ b.getD 2 0 ^^^ d.getD 1 0) (a.getD 1 0 ^^^ b.getD 0 0 ^^^ d.getD 2 0)
        (a.getD 2 0 ^^^ b.getD 1 0 ^^^ d.getD 0 0)

