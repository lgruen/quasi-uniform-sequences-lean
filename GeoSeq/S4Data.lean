/-- The state vectors of source `0` after a nonzero digit. -/
def S4Av : List (List StU) := S4A.map decVU

/-- The state vectors of source `0` before the first nonzero digit. -/
def S4Bv : List (List StU) := S4B.map decVU

/-- The change columns of source `c'`. -/
def S4Z (c' : ℕ) : List (List ℕ) := if c' = 0 then S4Z0 else if c' = 1 then S4Z1 else if c' = 2 then S4Z2 else S4Z3

/-- Entry `k` of pair column `t` (source `0`) as an element of `𝔽_4`. -/
def S4tupv (t k : ℕ) : F4 := n2f ((S4tup.getD t []).getD k 0)

/-- Entry `(i, c)` of the change column of type `ty` of pair column `t` of source `0`
(`eq:carrychange`, `Δ(ȳ) = ω²`): `ω² D_i(l)[c][0]` (`ty = 0`) or `D_i(l)[c][0] + ω D_i(l-1)[c][0]`. -/
def chgU (t ty i : ℕ) (c : Fin 4) : F4 :=
  if ty = 0 then F4.w2 * S4tupv t (4 * i + c) else S4tupv t (4 * i + c) + F4.w * S4tupv t (20 + 4 * i + c)

/-! ## The certificate check on words -/

/-- The lower bound for `4^5 f_5(e_c, σ_c)` from the word `w`: `4^5 - 1 - w` if `c` moves, else
`topW 5 w - 1`. -/
def s4b (m : Bool) (w : ℕ) : ℕ := if m then 1023 - w else topW 5 w - 1

/-- One case of the certificate check: `∑_c (bound)² ≥ 952`. -/
def s4ok (m0 m1 m2 m3 : Bool) (w0 w1 w2 w3 : ℕ) : Bool :=
  decide (952 ≤ s4b m0 w0 ^ 2 + s4b m1 w1 ^ 2 + s4b m2 w2 ^ 2 + s4b m3 w3 ^ 2)

/-- The change columns a source contributes: all of `S4Z c'` if it moves, the zero column if not. -/
def s4opt (m : Bool) (c' : ℕ) : List (List ℕ) := if m then S4Z c' else [[0, 0, 0, 0]]

/-- The certificate check by direct enumeration (moving sets with at most two elements). -/
def s4part (m0 m1 m2 m3 : Bool) : Bool :=
  (s4opt m0 0).all fun a => (s4opt m1 1).all fun b => (s4opt m2 2).all fun c => (s4opt m3 3).all fun d =>
    s4ok m0 m1 m2 m3 (a.getD 0 0 ^^^ b.getD 0 0 ^^^ c.getD 0 0 ^^^ d.getD 0 0)
      (a.getD 1 0 ^^^ b.getD 1 0 ^^^ c.getD 1 0 ^^^ d.getD 1 0)
      (a.getD 2 0 ^^^ b.getD 2 0 ^^^ c.getD 2 0 ^^^ d.getD 2 0)
      (a.getD 3 0 ^^^ b.getD 3 0 ^^^ c.getD 3 0 ^^^ d.getD 3 0)

/-- The bucket of the last source of the three-element moving set number `s`. -/
def s4bk3 (s k1 k2 : ℕ) : List (List ℕ) := ((S4BK3.getD s []).getD k1 []).getD k2 []

/-- The certificate check for a three-element moving set `{c₁ < c₂ < c₃}` (number `s`, non-moving
coordinate fixed by `m`): for each pair of columns of the first two sources, only the columns of the third source
in the bucket of the keys completing `31` (all five leading bits `1`) at `c₁, c₂` and with the matching key
at `c₃` are checked exactly; every other column leaves a moving coordinate with key `≠ 31` (`s4_far`). -/
def s4three (s c1 c2 c3 : ℕ) (m : ℕ → Bool) : Bool :=
  (S4Z c1).all fun a => (S4Z c2).all fun b =>
    (s4bk3 s (31 ^^^ (a.getD c1 0 / 32 ^^^ b.getD c1 0 / 32)) (31 ^^^ (a.getD c2 0 / 32 ^^^ b.getD c2 0 / 32))).all
      fun d => if d.getD c3 0 / 32 = 31 ^^^ (a.getD c3 0 / 32 ^^^ b.getD c3 0 / 32) then
        s4ok (m 0) (m 1) (m 2) (m 3) (a.getD 0 0 ^^^ b.getD 0 0 ^^^ d.getD 0 0)
          (a.getD 1 0 ^^^ b.getD 1 0 ^^^ d.getD 1 0) (a.getD 2 0 ^^^ b.getD 2 0 ^^^ d.getD 2 0)
          (a.getD 3 0 ^^^ b.getD 3 0 ^^^ d.getD 3 0)
      else true

/-- The certificate check for the steps that move all four coordinates: pairs of columns of sources
`0, 1` against the bucket of pairs of sources `2, 3` with the completing keys at targets `0, 1`, filtered by
the keys at targets `2, 3`. -/
noncomputable def s4full : Bool :=
  S4Z0.all fun a => S4Z1.all fun b =>
    (((S4PB.getD (31 ^^^ (a.getD 0 0 / 32 ^^^ b.getD 0 0 / 32)) []).getD
        (31 ^^^ (a.getD 1 0 / 32 ^^^ b.getD 1 0 / 32)) [])).all
      fun p => if p.getD 2 0 / 32 = 31 ^^^ (a.getD 2 0 / 32 ^^^ b.getD 2 0 / 32) ∧
          p.getD 3 0 / 32 = 31 ^^^ (a.getD 3 0 / 32 ^^^ b.getD 3 0 / 32) then
        s4ok true true true true (a.getD 0 0 ^^^ b.getD 0 0 ^^^ p.getD 0 0)
          (a.getD 1 0 ^^^ b.getD 1 0 ^^^ p.getD 1 0) (a.getD 2 0 ^^^ b.getD 2 0 ^^^ p.getD 2 0)
          (a.getD 3 0 ^^^ b.getD 3 0 ^^^ p.getD 3 0)
      else true

end GeoSeq
