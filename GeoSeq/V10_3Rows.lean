/-- **`prop:primepower`, row `s3_q121`** (`s = 3`, `q = 121`, `f = x^2+1`, weights `(55, 22)`): for all distinct places,
`θ, μ⋆ ≠ 0`, every staggered coordinate `c⋆` and the weights in the order `c⋆.succAbove`, the staggered residue
sequence over `GF121` with the power-basis code is a digital `(0,3)`-sequence with `sep(P_{3K}) ≥ 19/121` for every
`K ≥ 1`, `δ(P_{[N]}) ≥ (19/121²) N^{-1/3}`, and quasi-uniform. -/
theorem primepower_s3_q121 (a : Fin 3 → GF121) (ha : Function.Injective a) (θ : GF121) (hθ : θ ≠ 0) (cs : Fin 3)
    (μs : GF121) (hμ : μs ≠ 0) (k : Fin 3 → GF121) (hk : ∀ i, k (cs.succAbove i) = (![PF.dec 55, PF.dec 22] : Fin 2 → GF121) i) :
    PPConcl PF.code 3 (resStar a θ cs μs k) (19 / 121) := by
  have h := primepower_of_check (n := 2) PF.code (by norm_num) a ha θ hθ cs μs hμ k _ (by decide +kernel) hk
    (PF.elems 11 1 ![1, 0]) _ PF.mem_elems_aux (pp_delta_s3_q121)
    ![[PF.dec 55, PF.dec 61], [PF.dec 22, PF.dec 31]]
    [PF.dec 22, PF.dec 31, PF.dec 33, PF.dec 35, PF.dec 39, PF.dec 41, PF.dec 44, PF.dec 46, PF.dec 49, PF.dec 51, PF.dec 55, PF.dec 61, PF.dec 66, PF.dec 71, PF.dec 77, PF.dec 81, PF.dec 83, PF.dec 86, PF.dec 88, PF.dec 91, PF.dec 93, PF.dec 97, PF.dec 99, PF.dec 101]
    19 (by norm_num) (by decide +kernel)
  have e : ((19 : ℕ) : ℝ) / ((11 ^ (1 + 1) : ℕ) : ℝ) = 19 / 121 := by norm_num
  rwa [e] at h

/-- `s3_q125`: the digit increments of the power-basis code of `GF125` lie in `{1, 1+x, …}`. -/
theorem pp_delta_s3_q125 : ∀ y : GF125, digInc PF.code y ∈ PF.pbDelta 5 2 ![1, 1, 0] :=
  PF.forall_of_dec (P := fun y : GF125 => digInc PF.code y ∈ PF.pbDelta 5 2 ![1, 1, 0]) (by decide +kernel)

/-- **`prop:primepower`, row `s3_q125`** (`s = 3`, `q = 125`, `f = x^3+x+1`, weights `(35, 26)`): for all distinct places,
`θ, μ⋆ ≠ 0`, every staggered coordinate `c⋆` and the weights in the order `c⋆.succAbove`, the staggered residue
sequence over `GF125` with the power-basis code is a digital `(0,3)`-sequence with `sep(P_{3K}) ≥ 8/125` for every
`K ≥ 1`, `δ(P_{[N]}) ≥ (8/125²) N^{-1/3}`, and quasi-uniform. -/
theorem primepower_s3_q125 (a : Fin 3 → GF125) (ha : Function.Injective a) (θ : GF125) (hθ : θ ≠ 0) (cs : Fin 3)
    (μs : GF125) (hμ : μs ≠ 0) (k : Fin 3 → GF125) (hk : ∀ i, k (cs.succAbove i) = (![PF.dec 35, PF.dec 26] : Fin 2 → GF125) i) :
    PPConcl PF.code 3 (resStar a θ cs μs k) (8 / 125) := by
  have h := primepower_of_check (n := 2) PF.code (by norm_num) a ha θ hθ cs μs hμ k _ (by decide +kernel) hk
    (PF.elems 5 2 ![1, 1, 0]) _ PF.mem_elems_aux (pp_delta_s3_q125)
    ![[PF.dec 35, PF.dec 67, PF.dec 84], [PF.dec 25, PF.dec 26, PF.dec 45]]
    [PF.dec 10, PF.dec 14, PF.dec 15, PF.dec 16, PF.dec 25, PF.dec 26, PF.dec 35, PF.dec 41, PF.dec 42, PF.dec 45, PF.dec 46, PF.dec 47, PF.dec 55, PF.dec 58, PF.dec 59, PF.dec 60, PF.dec 61, PF.dec 62, PF.dec 63, PF.dec 64, PF.dec 67, PF.dec 68, PF.dec 71, PF.dec 84, PF.dec 87, PF.dec 88, PF.dec 90, PF.dec 91, PF.dec 92, PF.dec 93, PF.dec 94, PF.dec 95, PF.dec 96, PF.dec 97, PF.dec 100, PF.dec 104, PF.dec 105, PF.dec 108, PF.dec 109, PF.dec 113, PF.dec 114, PF.dec 115]
    8 (by norm_num) (by decide +kernel)
  have e : ((8 : ℕ) : ℝ) / ((5 ^ (2 + 1) : ℕ) : ℝ) = 8 / 125 := by norm_num
  rwa [e] at h

end GeoSeq
