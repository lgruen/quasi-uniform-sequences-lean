/-!
# GeoSeq stage V10-4: data of the improved `s = 6` block design (generated by `scripts/gen_v10_4_s6.py`)

* `blk6dF`: the off-diagonal entries of `U*_6` (the nets' deterministic rule `def:Ustar`, as produced by the nets
  script `ustar_det.py`) and the free diagonal `F_0[c][c] = -δ_c`, `δ = (3, 12, 13, 14, 13, 13)` (`U*_6`:
  `-(43, 14, 23, 27, 22, 14)`); places `0, 1, 1/2, …, 1/5` (`ustarA 6`), row constants `(1, 1, 2, 3, 4, 5)` (`ustarV 6`).
* `blk6dM`, `blk6dB`: partial sums and the bounds `max_j |M^{(j)}[i][c]|` (row sums `≤ 46`).
* `blk6G`: the nets-form reachability polynomials `G_{c,n}` (`F_n[i][c] = w̃_{ic} G_{c,n}(ỹ_{ic})`), coefficients
  `num/24`.
* The checker options (`caOpts`) split into the first coordinate `blk6dO0` and the rest `blk6dRest`.
* `blk6d θ`: the block-periodic residue sequence (`ℓ = 6`) with the numerators `designNd` of `def:block`(a).
-/

namespace GeoSeq

open Finset Polynomial

/-- The improved `s = 6` design: `U*_6` off the diagonal, `F_0[c][c] = -(3, 12, 13, 14, 13, 13)`. -/
def blk6dF : ℕ → Fin 6 → Fin 6 → ℤ := fun n =>
  if n = 0 then !![-3, 12, 6, 2, 6, 12; 1, -12, -6, -1, -2, -3; 1, 12, -13, -2, -3, -4; 1, 6, 6, -14, -6, -6; 1, 4, 3, 2, -13, -12; 1, 3, 2, 1, 6, -13] else if n = 1 then !![0, -26, -5, -3, -7, 2; -3, 0, 11, 2, 3, 1; -2, -2, 0, 5, 5, 2; -1, -7, 1, 0, 13, 5; 0, -6, -1, -1, 0, 22; 1, -5, -1, -1, -1, 0] else if n = 2 then !![0, 11, -5, -2, -3, -17; 4, 0, -6, 0, 0, 4; 1, -15, 0, -4, -1, 5; -1, -4, -4, 0, -10, 6; -2, -1, -3, 0, 0, -5; -2, 0, -2, -1, -4, 0] else if n = 3 then !![0, 2, 3, 3, 5, 4; -3, 0, 2, -1, -2, -2; 0, 11, 0, 2, -3, -3; 1, 5, -9, 0, -3, -5; 1, 3, -1, 0, 0, 1; 1, 2, 0, 1, 0, 0] else !![0, 1, 1, 0, -1, -1; 2, 0, -2, 0, 1, 0; 0, -5, 0, -2, 2, 0; 0, 0, 6, 0, 6, 0; 0, 0, 2, -1, 0, -7; -1, 0, 1, 0, 0, 0]

/-- The partial sums `M^{(j)} = F_0 + ⋯ + F_j` of `blk6dF`. -/
def blk6dM : ℕ → Fin 6 → Fin 6 → ℤ := fun n =>
  if n = 0 then !![-3, 12, 6, 2, 6, 12; 1, -12, -6, -1, -2, -3; 1, 12, -13, -2, -3, -4; 1, 6, 6, -14, -6, -6; 1, 4, 3, 2, -13, -12; 1, 3, 2, 1, 6, -13] else if n = 1 then !![-3, -14, 1, -1, -1, 14; -2, -12, 5, 1, 1, -2; -1, 10, -13, 3, 2, -2; 0, -1, 7, -14, 7, -1; 1, -2, 2, 1, -13, 10; 2, -2, 1, 0, 5, -13] else if n = 2 then !![-3, -3, -4, -3, -4, -3; 2, -12, -1, 1, 1, 2; 0, -5, -13, -1, 1, 3; -1, -5, 3, -14, -3, 5; -1, -3, -1, 1, -13, 5; 0, -2, -1, -1, 1, -13] else if n = 3 then !![-3, -1, -1, 0, 1, 1; -1, -12, 1, 0, -1, 0; 0, 6, -13, 1, -2, 0; 0, 0, -6, -14, -6, 0; 0, 0, -2, 1, -13, 6; 1, 0, -1, 0, 1, -13] else !![-3, 0, 0, 0, 0, 0; 1, -12, -1, 0, 0, 0; 0, 1, -13, -1, 0, 0; 0, 0, 0, -14, 0, 0; 0, 0, 0, 0, -13, -1; 0, 0, 0, 0, 1, -13]

/-- The bounds `B_{ic} = max_j |M^{(j)}[i][c]|` of `blk6dF`. -/
def blk6dB : Fin 6 → Fin 6 → ℤ := !![3, 14, 6, 3, 6, 14; 2, 12, 6, 1, 2, 3; 1, 12, 13, 3, 3, 4; 1, 6, 7, 14, 7, 6; 1, 4, 3, 2, 13, 12; 2, 3, 2, 1, 6, 13]

/-- Numerators (over `24`) of the coefficients of the nets-form polynomials `G_{c,n}` (`c` outer, `n`, power `k`). -/
def blk6GL : List (List (List ℤ)) :=
  [[[24], [-72, 24], [96, -84, 12], [-72, 104, -36, 4], [48, -94, 59, -14, 1]], [[288], [-624, 576], [264, -1200, 576], [48, 840, -1200, 576], [24, -220, 660, -680, 96]], [[144], [-120, 144], [-120, -120, 144], [72, -156, -204, 72], [24, 131, 66, -83, 6]], [[48], [-72, 48], [-48, -48, 96], [72, -8, -96, 32], [0, 12, -4, -48, 16]], [[144], [-168, 144], [-72, -168, 144], [120, -108, -84, 72], [-24, 133, -54, -61, 6]], [[288], [48, 576], [-408, 48, 576], [96, -408, 48, 576], [-24, -212, -588, -472, 96]]]

/-- The nets-form reachability polynomials `G_{c,n} = ∑_{k ≤ n} (num/24) X^k` of `blk6dF`. -/
noncomputable def blk6G {p : ℕ} [Fact p.Prime] : Fin 6 → ℕ → (ZMod p)[X] :=
  fun c n => ∑ k ∈ range (n + 1), C (cfOf (s := 6) blk6GL 24 c n k) * X ^ k

