/-- The start `caStart 6` of the checker (literal). -/
def blk6dSt0 : ℤ := 70644700037184

/-- **The improved `s = 6` block-periodic residue sequence**: places `0, 1, 1/2, …, 1/5`, `v = (1, 1, 2, 3, 4, 5)`,
the design `blk6dF`, `ℓ = 6`. -/
noncomputable def blk6d {p : ℕ} [Fact p.Prime] (θ : ZMod p) : Gen 6 (ZMod p) :=
  blockGen (ustarA 6) θ 6 (ustarV 6) (blockF blk6dF) (designNd (ustarA 6) (ustarV 6) (blockF blk6dF)) 1

end GeoSeq
