   [(0, 0), (16, 2212007967238), (16, 1108218152193), (16, -1103757115652), (16, -1108203077377), (16, -852224), (32, -2212007967238), (32, -1108218152193), (32, 1103757115652), (32, 1108203077377), (32, 852224)],
