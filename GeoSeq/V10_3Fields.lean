/-- `𝔽_8 = 𝔽_2[x]/(x^3+x+1)` in the power basis (`sec:primepower`). -/
abbrev GF8 := PF 2 2 ![1, 1, 0]

/-- The inverses in `GF8`, by codes. -/
def invGF8 : List ℕ := [0, 1, 5, 6, 7, 2, 3, 4]

/-- `GF8` is a field (inverse table checked by the kernel; `f` is irreducible). -/
noncomputable instance instFieldGF8 : Field GF8 :=
  PF.mkField (PF.tabInv invGF8) (by decide +kernel) (by decide +kernel)
    (PF.forall_of_dec (P := fun a : GF8 => a ≠ 0 → a * PF.tabInv invGF8 a = 1) (by decide +kernel))

