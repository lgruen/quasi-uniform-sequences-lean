/-!
# Solution of the geoseq V4 headline entry (`HeadlineSeqV4/Challenge.lean`)

The definitions are those of the Challenge (`HeadlineSeqV4/Defs.lean`, a verbatim copy generated by
`scripts/gen_headline_seq_v4_defs.py`). They are written from scratch, importing only Mathlib; the bridge
lemmas below show that each of them is the corresponding definition of the full formalization `GeoSeq`
(digital sequences through the digit code `GeoSeq.zcode p`, `r ↦ r.val`). All bridges hold by definitional
unfolding, except `resGen_eq`, which is the entry formula `GeoSeq.resSeq_faure_apply` of `def:residue`.

The theorems come from the compared theorems of the full formalization: `GeoSeq.halton_not_quasiUniform`
(`comparatorGeoSeqV93.json`), `GeoSeq.residue_korobov_explicit`, `korRho_two_le_iff`, `korRho_pow_lt`,
`korobov_ne_zero`, `faurePlace_injective`, `resSeq_faure_apply` (`comparatorGeoSeqV9.json`).
`halton_bases_exist` is proved here (Euclid's construction).
-/

namespace GeoSeqV4

open Finset Polynomial

/-! ## Bridge lemmas: the Challenge's definitions are those of `GeoSeq` -/

section Bridge

variable {s p : ℕ}

theorem seqPoint_eq [NeZero p] (C : Fin s → ℕ → ℕ → ZMod p) :
    seqPoint p C = GeoSeq.seqPoint (GeoSeq.zcode p) C := rfl

theorem isSeq0_iff [NeZero p] (C : Fin s → ℕ → ℕ → ZMod p) :
    IsSeq0 p C ↔ GeoSeq.IsSeq0 (GeoSeq.zcode p) C := Iff.rfl

theorem euclDist_eq (x y : Fin s → ℝ) : euclDist x y = GeoSeq.euclDist x y := rfl

theorem torDist_eq (x y : Fin s → ℝ) : torDist x y = GeoSeq.torDistR x y := rfl

theorem isQuasiUniform_iff (pt : ℕ → Fin s → ℝ) : IsQuasiUniform pt ↔ GeoSeq.IsQuasiUniform pt :=
  Iff.rfl

theorem idxPoly_eq (n : ℕ) : idxPoly p n = GeoSeq.idxPolyP p n := rfl

theorem haltonPt_eq [Fact p.Prime] (b : Fin s → Polynomial (ZMod p)) :
    haltonPt p b = GeoSeq.haltonPt p b := rfl

theorem place_eq : (place p : Fin s → ZMod p) = GeoSeq.faurePlace p := rfl

theorem wPart_eq [Fact p.Prime] (c : Fin s) : wPart p c = GeoSeq.wCo (GeoSeq.faurePlace p) c := rfl

theorem korobov_eq : korobov p s = GeoSeq.korobov p s := rfl

theorem resGen_eq [Fact p.Prime] (v : Fin s → ZMod p) :
    resGen p v = GeoSeq.resSeq (GeoSeq.faurePlace p) 1 v := by
  funext c n i
  rw [GeoSeq.resSeq_faure_apply]
  rfl

end Bridge

/-! ## Euclid's pairwise coprime polynomials -/

section Euclid

variable (p : ℕ) [Fact p.Prime]

/-- `euP n = b_0 b_1 ⋯ b_n`. -/
noncomputable def euP : ℕ → Polynomial (ZMod p)
  | 0 => X
  | n + 1 => euP n * (X * euP n + 1)

/-- Euclid's bases: `b_0 = z`, `b_{n+1} = z b_0 ⋯ b_n + 1`. -/
noncomputable def euB : ℕ → Polynomial (ZMod p)
  | 0 => X
  | n + 1 => X * euP p n + 1

lemma X_mul_add_one_ne_zero (f : Polynomial (ZMod p)) : X * f + 1 ≠ 0 := by
  intro h
  have := congrArg (Polynomial.eval 0) h
  simp at this

lemma euP_ne_zero (n : ℕ) : euP p n ≠ 0 := by
  induction n with
  | zero => exact X_ne_zero
  | succ n ih => exact mul_ne_zero ih (X_mul_add_one_ne_zero p _)

lemma euB_dvd_euP {k n : ℕ} (hk : k ≤ n) : euB p k ∣ euP p n := by
  induction n with
  | zero => rw [Nat.le_zero.mp hk]; exact dvd_rfl
  | succ n ih =>
    rcases Nat.lt_or_ge k (n + 1) with h | h
    · exact (ih (by omega)).trans (dvd_mul_right _ _)
    · rw [show k = n + 1 by omega]; exact dvd_mul_left _ _

lemma euB_natDegree (k : ℕ) : 1 ≤ (euB p k).natDegree := by
  cases k with
  | zero => simp [euB]
  | succ n =>
    have h1 : (X * euP p n).natDegree = (euP p n).natDegree + 1 := natDegree_X_mul (euP_ne_zero p n)
    simp only [euB]
    rw [natDegree_add_eq_left_of_natDegree_lt (by rw [h1]; simp)]
    omega

lemma euB_coprime {j n : ℕ} (h : j < n) : IsCoprime (euB p j) (euB p n) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hc : IsCoprime (euP p m) (X * euP p m + 1) := ⟨-X, 1, by ring⟩
  exact hc.of_isCoprime_of_dvd_left (euB_dvd_euP p (by omega))

end Euclid

/-! ## The statements -/

theorem halton_not_quasiUniform (p : ℕ) [Fact p.Prime] (s : ℕ) (hs : 2 ≤ s)
    (b : Fin s → Polynomial (ZMod p)) (hdeg : ∀ c, 1 ≤ (b c).natDegree)
    (hcop : Pairwise fun c c' => IsCoprime (b c) (b c')) :
    (∀ ε : ℝ, 0 < ε → ∃ m v w : ℕ, v < p ^ m ∧ w < p ^ m ∧ v ≠ w ∧
        euclDist (haltonPt p b v) (haltonPt p b w) < ε * ((p : ℝ) ^ m) ^ (-(1 : ℝ) / s)) ∧
      ¬ IsQuasiUniform (haltonPt p b) :=
  GeoSeq.halton_not_quasiUniform p s hs b hdeg hcop

theorem halton_bases_exist (p : ℕ) [Fact p.Prime] (s : ℕ) :
    ∃ b : Fin s → Polynomial (ZMod p),
      (∀ c, 1 ≤ (b c).natDegree) ∧ Pairwise fun c c' => IsCoprime (b c) (b c') := by
  refine ⟨fun c => euB p c, fun c => euB_natDegree p c, fun c c' hne => ?_⟩
  have hne' : (c : ℕ) ≠ c' := fun h => hne (Fin.ext h)
  rcases Nat.lt_or_gt_of_ne hne' with h | h
  · exact euB_coprime p h
  · exact (euB_coprime p h).symm

theorem residue_quasiUniform (s p : ℕ) [Fact p.Prime] (hs : 2 ≤ s) (hps : 2 ^ s < p) :
    IsSeq0 p (resGen p (korobov p s)) ∧
      (∀ K : ℕ, 1 ≤ K → ∀ v w : ℕ, v < p ^ (s * K - 1) → w < p ^ (s * K - 1) → v ≠ w →
        ((⌊(p : ℝ) ^ ((1 : ℝ) / s)⌋₊ : ℝ) - 1) * (p : ℝ) ^ (-(1 : ℝ) / s) *
            ((p ^ (s * K - 1) : ℕ) : ℝ) ^ (-(1 : ℝ) / s) ≤
          torDist (seqPoint p (resGen p (korobov p s)) v) (seqPoint p (resGen p (korobov p s)) w)) ∧
      IsQuasiUniform (seqPoint p (resGen p (korobov p s))) := by
  rw [resGen_eq]
  exact GeoSeq.residue_korobov_explicit hs hps

theorem residue_data (s p : ℕ) [Fact p.Prime] (hs : 2 ≤ s) (hps : 2 ^ s < p) :
    2 ≤ ⌊(p : ℝ) ^ ((1 : ℝ) / s)⌋₊ ∧ ⌊(p : ℝ) ^ ((1 : ℝ) / s)⌋₊ ^ s < p ∧
      (∀ c, korobov p s c ≠ 0) ∧ Function.Injective (place p : Fin s → ZMod p) ∧
      ∀ c : Fin s, (Polynomial.taylor (place p c) (wPart p c) : PowerSeries (ZMod p)) *
        (Polynomial.taylor (place p c) (wPart p c) : PowerSeries (ZMod p))⁻¹ = 1 := by
  have hsp : s ≤ p := ((Nat.lt_two_pow_self).trans hps).le
  have hinj : Function.Injective (place p : Fin s → ZMod p) := GeoSeq.faurePlace_injective hsp
  refine ⟨(GeoSeq.korRho_two_le_iff hs).mpr hps, GeoSeq.korRho_pow_lt hs,
    fun c => GeoSeq.korobov_ne_zero hs c, hinj, fun c => PowerSeries.mul_inv_cancel _ ?_⟩
  rw [Polynomial.constantCoeff_coe, Polynomial.taylor_coeff_zero,
    wPart, Polynomial.eval_prod, Finset.prod_ne_zero_iff]
  intro c' hc'
  rw [eval_sub, eval_X, eval_C, sub_ne_zero]
  exact fun h => (Finset.ne_of_mem_erase hc') (hinj h).symm

end GeoSeqV4

